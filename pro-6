```c
#include <stdio.h>

int main()
{
    int n, i, time = 0, done = 0;
    int at[10], bt[10], rt[10], p[10], wt[10], tat[10];

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("Enter arrival time, burst time and priority: ");
        scanf("%d%d%d", &at[i], &bt[i], &p[i]);
        rt[i] = bt[i];
    }

    while(done < n)
    {
        int k = -1;

        for(i = 0; i < n; i++)
            if(at[i] <= time && rt[i] > 0 &&
               (k == -1 || p[i] < p[k]))
                k = i;

        if(k == -1)
        {
            time++;
            continue;
        }

        rt[k]--;
        time++;

        if(rt[k] == 0)
        {
            done++;
            tat[k] = time - at[k];
            wt[k] = tat[k] - bt[k];
        }
    }

    printf("\nProcess\tWT\tTAT\n");

    for(i = 0; i < n; i++)
        printf("P%d\t%d\t%d\n", i + 1, wt[i], tat[i]);

    return 0;
}
