#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int fd;
    char buffer[100];

    fd = open("file.txt", O_CREAT | O_WRONLY, 0644);
    write(fd, "Hello UNIX System Calls\n", 22);
    close(fd);

    fd = open("file.txt", O_RDONLY);
    read(fd, buffer, 22);
    buffer[22] = '\0';

    printf("File Content: %s", buffer);

    close(fd);

    return 0;
}
