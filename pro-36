
#include <stdio.h>

int main()
{
    int block[100], n, i;

    printf("Enter the number of blocks: ");
    scanf("%d", &n);

    printf("\nEnter the disk block addresses:\n");

    for(i = 0; i < n; i++)
    {
        printf("Block %d: ", i + 1);
        scanf("%d", &block[i]);
    }

    printf("\nLinked File Allocation:\n");

    printf("First Block: %d\n", block[0]);
    printf("Last Block: %d\n", block[n - 1]);

    printf("\nFile Block Chain:\n");

    for(i = 0; i < n - 1; i++)
    {
        printf("%d -> ", block[i]);
    }

    printf("%d -> NULL\n", block[n - 1]);

    return 0;
}
