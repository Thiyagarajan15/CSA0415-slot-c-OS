#include <stdio.h>

int main()
{
    FILE *fp;
    char ch;
    int choice;

    printf("1. Create File\n");
    printf("2. Write File\n");
    printf("3. Read File\n");
    printf("4. Append File\n");
    printf("5. Exit\n");

    printf("Enter your choice: ");
    scanf("%d", &choice);

    switch(choice)
    {
        case 1:
            fp = fopen("file.txt", "w");
            printf("File created successfully\n");
            fclose(fp);
            break;

        case 2:
            fp = fopen("file.txt", "w");
            printf("Enter text: ");
            getchar();
            while((ch = getchar()) != '\n')
                fputc(ch, fp);
            fclose(fp);
            printf("File written successfully\n");
            break;

        case 3:
            fp = fopen("file.txt", "r");
            if(fp == NULL)
            {
                printf("File not found\n");
                break;
            }
            while((ch = fgetc(fp)) != EOF)
                putchar(ch);
            fclose(fp);
            break;

        case 4:
            fp = fopen("file.txt", "a");
            printf("Enter text: ");
            getchar();
            while((ch = getchar()) != '\n')
                fputc(ch, fp);
            fclose(fp);
            printf("Data appended successfully\n");
            break;

        case 5:
            printf("Exit\n");
            break;

        default:
            printf("Invalid choice\n");
    }

    return 0;
}
