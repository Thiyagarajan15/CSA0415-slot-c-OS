#include <stdio.h>

int main()
{
    int pages[50], frames[10];
    int n, f, i, j, k, flag, faults = 0;
    int pos, farthest, found;

    printf("Enter the number of pages: ");
    scanf("%d", &n);

    printf("Enter the page reference string: ");
    for(i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter the number of frames: ");
    scanf("%d", &f);

    for(i = 0; i < f; i++)
        frames[i] = -1;

    printf("\nPage\tFrames\t\tStatus\n");

    for(i = 0; i < n; i++)
    {
        flag = 0;

        for(j = 0; j < f; j++)
        {
            if(frames[j] == pages[i])
            {
                flag = 1;
                break;
            }
        }

        if(flag == 0)
        {
            pos = -1;

            for(j = 0; j < f; j++)
            {
                if(frames[j] == -1)
                {
                    pos = j;
                    break;
                }
            }

            if(pos == -1)
            {
                farthest = -1;

                for(j = 0; j < f; j++)
                {
                    found = 0;

                    for(k = i + 1; k < n; k++)
                    {
                        if(frames[j] == pages[k])
                        {
                            found = k;
                            break;
                        }
                    }

                    if(found == 0)
                    {
                        pos = j;
                        break;
                    }

                    if(found > farthest)
                    {
                        farthest = found;
                        pos = j;
                    }
                }
            }

            frames[pos] = pages[i];
            faults++;
        }

        printf("%d\t", pages[i]);

        for(j = 0; j < f; j++)
        {
            if(frames[j] == -1)
                printf("- ");
            else
                printf("%d ", frames[j]);
        }

        if(flag == 0)
            printf("\tPage Fault\n");
        else
            printf("\tPage Hit\n");
    }

    printf("\nTotal Page Faults = %d\n", faults);

    return 0;
}
