#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main()
{
    int fd;
    struct stat st;
    DIR *dir;
    struct dirent *entry;

    fd = open("file.txt", O_CREAT | O_RDWR, 0644);

    write(fd, "Hello UNIX", 10);

    fcntl(fd, F_GETFL);

    lseek(fd, 0, SEEK_SET);

    printf("File opened successfully\n");

    fstat(fd, &st);
    printf("File size: %ld bytes\n", st.st_size);

    close(fd);

    dir = opendir(".");
    printf("\nDirectory contents:\n");

    while((entry = readdir(dir)) != NULL)
       printf("%s\n", entry->d_name);

    closedir(dir);

    return 0;
}
