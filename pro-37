
#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n, i, head, total = 0;
    int request[100];

    printf("Enter the number of requests: ");
    scanf("%d", &n);

    printf("Enter the disk requests:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &request[i]);
    }

    printf("Enter the initial head position: ");
    scanf("%d", &head);

    printf("\nDisk Head Movement:\n");

    for(i = 0; i < n; i++)
    {
        printf("%d -> ", head);

        total += abs(request[i] - head);
        head = request[i];
    }

    printf("%d\n", head);

    printf("\nTotal Head Movement = %d\n", total);

    return 0;
}
