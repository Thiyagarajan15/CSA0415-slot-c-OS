
#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n, i, j, head, size, seek = 0;
    int req[100], temp;
    int direction;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter disk size: ");
    scanf("%d", &size);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    printf("Enter disk requests:\n");
    for(i = 0; i < n; i++)
        scanf("%d", &req[i]);

    printf("Enter direction (0 = Left, 1 = Right): ");
    scanf("%d", &direction);

    // Sort requests
    for(i = 0; i < n - 1; i++)
    {
        for(j = i + 1; j < n; j++)
        {
            if(req[i] > req[j])
            {
                temp = req[i];
                req[i] = req[j];
                req[j] = temp;
            }
        }
    }

    printf("\nSeek Sequence: ");
    
    if(direction == 1)
    {
        for(i = 0; i < n; i++)
        {
            if(req[i] >= head)
            {
                printf("%d ", req[i]);
                seek += abs(head - req[i]);
                head = req[i];
            }
        }

        seek += abs(head - (size - 1));
        head = size - 1;

        for(i = n - 1; i >= 0; i--)
        {
            if(req[i] < head && req[i] >= 0)
            {
                printf("%d ", req[i]);
                seek += abs(head - req[i]);
                head = req[i];
            }
        }
    }
    else
    {
        for(i = n - 1; i >= 0; i--)
        {
            if(req[i] <= head)
            {
                printf("%d ", req[i]);
                seek += abs(head - req[i]);
                head = req[i];
            }
        }

        seek += abs(head - 0);
        head = 0;

        for(i = 0; i < n; i++)
        {
            if(req[i] > head)
            {
                printf("%d ", req[i]);
                seek += abs(head - req[i]);
                head = req[i];
            }
        }
    }

    printf("\nTotal Seek Movement = %d\n", seek);

    return 0;
}
