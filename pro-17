```c
#include <stdio.h>

struct employee {
    int id;
    char name[20];
    float salary;
};

int main()
{
    struct employee e;
    FILE *fp;
    int n, i;

    fp = fopen("emp.dat", "wb+");

    printf("Enter number of employees: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Enter ID, Name and Salary: ");
        scanf("%d %19s %f", &e.id, e.name, &e.salary);
        fwrite(&e, sizeof(e), 1, fp);
    }

    printf("Enter employee number to search: ");
    scanf("%d", &i);

    fseek(fp, (i - 1) * sizeof(e), SEEK_SET);
    fread(&e, sizeof(e), 1, fp);

    printf("\nID: %d\nName: %s\nSalary: %.2f\n",
           e.id, e.name, e.salary);

    fclose(fp);
    return 0;
}
