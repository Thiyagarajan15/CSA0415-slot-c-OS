#include <stdio.h>

int main()
{
    int pages[50], frames[10];
    int n, f, i, j, k, faults = 0;
    int flag, pos = 0;

    printf("Enter the number of pages: ");
    scanf("%d", &n);

    printf("Enter the page reference string: ");
    for(i = 0; i < n; i++)
        scanf("%d", &pages[i]);

    printf("Enter the number of frames: ");
    scanf("%d", &f);

    for(i = 0; i < f; i++)
        frames[i] = -1;

    printf("\nPage\tFrames\t\tStatus\n");

    for(i = 0; i < n; i++)
    {
        flag = 0;

        for(j = 0; j < f; j++)
        {
            if(frames[j] == pages[i])
            {
                flag = 1;
                break;
            }
        }

        if(flag == 0)
        {
            frames[pos] = pages[i];
            pos = (pos + 1) % f;
            faults++;
        }

        printf("%d\t", pages[i]);

        for(k = 0; k < f; k++)
        {
            if(frames[k] == -1)
                printf("- ");
            else
                printf("%d ", frames[k]);
        }

        if(flag == 0)
            printf("\tPage Fault\n");
        else
            printf("\tPage Hit\n");
    }

    printf("\nTotal Page Faults = %d\n", faults);

    return 0;
}
